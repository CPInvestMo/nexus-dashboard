{
  // Set real D1 database_id only after verifying Cloudflare access and Free plan.
  "name": "nael-command-center-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-22",
  "workers_dev": true,
  "d1_databases": [{
    "binding": "DB",
    "database_name": "nael-db",
    "database_id": "REPLACE_WITH_VERIFIED_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }],
  "observability": { "enabled": true }
}
